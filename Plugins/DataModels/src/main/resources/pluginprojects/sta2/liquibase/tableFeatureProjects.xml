    <changeSet author="generated" id="2026-06-11-feature_projects" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="CONTINUE">
            <tableExists tableName="projects" />
            <tableExists tableName="features" />
            <not>
                <tableExists tableName="feature_projects" />
            </not>
            <changeLogPropertyDefined property="idType-Project" />
            <changeLogPropertyDefined property="idType-Feature" />
        </preConditions>
        <createTable tableName="feature_projects">
            <column name="project_id" type="${idType-Project}">
                <constraints nullable="false"/>
            </column>
            <column name="feature_id" type="${idType-Feature}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey columnNames="project_id, feature_id" constraintName="pk_feature_projects" tableName="feature_projects"/>
        <createIndex tableName="feature_projects" indexName="feature_projects_project_id">
            <column name="project_id" />
        </createIndex>
        <createIndex tableName="feature_projects" indexName="feature_projects_feature_id">
            <column name="feature_id" />
        </createIndex>
    </changeSet>

</databaseChangeLog>

