    <changeSet author="generated" id="2026-06-11-user_roles" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="CONTINUE">
            <tableExists tableName="users" />
            <tableExists tableName="roles" />
            <not>
                <tableExists tableName="user_roles" />
            </not>
            <changeLogPropertyDefined property="idType-User" />
            <changeLogPropertyDefined property="idType-Role" />
        </preConditions>
        <createTable tableName="user_roles">
            <column name="user_name" type="${idType-User}">
                <constraints nullable="false"/>
            </column>
            <column name="role_name" type="${idType-Role}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey columnNames="user_name, role_name" constraintName="pk_user_roles" tableName="user_roles"/>
        <createIndex tableName="user_roles" indexName="user_roles_user_name">
            <column name="user_name" />
        </createIndex>
        <createIndex tableName="user_roles" indexName="user_roles_role_name">
            <column name="role_name" />
        </createIndex>
    </changeSet>

