    <changeSet author="iosb" id="2025-05-05-tn_linking_time-1" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="MARK_RAN">
            <changeLogPropertyDefined property="id-LinkingTime" value="LONG" />
            <not>
                <tableExists tableName="tn_linking_time" />
            </not>
        </preConditions>
        <createTable tableName="tn_linking_time">
            <column name="id" type="${idTypeLong}" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_tn_linking_time" />
            </column>
        </createTable>
    </changeSet>

    <changeSet author="iosb" id="2025-05-05-tn_linking_time-2" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="MARK_RAN">
            <or>
                <changeLogPropertyDefined property="id-LinkingTime" value="STRING" />
                <changeLogPropertyDefined property="id-LinkingTime" value="UUID" />
            </or>
            <not>
                <tableExists tableName="tn_linking_time" />
            </not>
        </preConditions>
        <createTable tableName="tn_linking_time">
            <column name="id" type="${idType-LinkingTime}" defaultValueComputed="${defaultValueComputed-LinkingTime}">
                <constraints primaryKey="true" primaryKeyName="pk_tn_linking_time"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="iosb" id="2025-05-05-tn_linking_time-3" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="CONTINUE">
            <tableExists tableName="tn_linking_time" />
            <not>
                <columnExists columnName="time_start" tableName="tn_linking_time" />
            </not>
        </preConditions>
        <addColumn tableName="tn_linking_time">
            <column name="thing_id" type="${idType-Thing}">
                <constraints nullable="false"/>
            </column>
            <column name="network_id" type="${idType-MonitoringNetwork}">
                <constraints nullable="false"/>
            </column>
            <column name="time_start" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="time_end" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
    </changeSet>

    <changeSet author="iosb" id="2025-05-05-tn_linking_time-idx-thing_id" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="CONTINUE">
            <tableExists tableName="tn_linking_time" />
            <not>
                <indexExists tableName="tn_linking_time" indexName="tn_linking_time_thing_id" />
            </not>
        </preConditions>
        <createIndex tableName="tn_linking_time" indexName="tn_linking_time_thing_id">
            <column name="thing_id" />
        </createIndex>
    </changeSet>

    <changeSet author="iosb" id="2025-05-05-tn_linking_time-idx-network_id" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="CONTINUE">
            <tableExists tableName="tn_linking_time" />
            <not>
                <indexExists tableName="tn_linking_time" indexName="tn_linking_time_network_id" />
            </not>
        </preConditions>
        <createIndex tableName="tn_linking_time" indexName="tn_linking_time_network_id">
            <column name="network_id" />
        </createIndex>
    </changeSet>

</databaseChangeLog>

