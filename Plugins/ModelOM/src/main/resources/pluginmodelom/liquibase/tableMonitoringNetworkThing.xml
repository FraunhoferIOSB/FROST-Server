    <changeSet author="iosb" id="2025-05-05-monitoring_network_thing" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="CONTINUE">
            <tableExists tableName="monitoring_networks" />
            <tableExists tableName="things" />
            <not>
                <tableExists tableName="monitoring_network_thing" />
            </not>
            <changeLogPropertyDefined property="idType-MonitoringNetwork" />
            <changeLogPropertyDefined property="idType-Thing" />
        </preConditions>
        <createTable tableName="monitoring_network_thing">
            <column name="network_id" type="${idType-MonitoringNetwork}">
                <constraints nullable="false"/>
            </column>
            <column name="thing_id" type="${idType-Thing}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey columnNames="network_id, thing_id" constraintName="pk_monitoring_network_thing" tableName="monitoring_network_thing"/>
        <createIndex tableName="monitoring_network_thing" indexName="monitoring_network_thing_network_id">
            <column name="network_id" />
        </createIndex>
        <createIndex tableName="monitoring_network_thing" indexName="monitoring_network_thing_thing_id">
            <column name="thing_id" />
        </createIndex>
    </changeSet>

</databaseChangeLog>

