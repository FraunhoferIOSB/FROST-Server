                  {
                    "targetTable": "users",
                    "targetAlias": "u",
                    "joinOnSql": "upr.\"user_name\" \u003d u.\"user_name\" ",
                    "joinType": "LEFT"
                  }
                ],
                "where": "(pr.\"ispublic\" and not th.\"restricted\") or u.\"user_name\" \u003d ?",
                "usernameParameter": true
              }
            }
          ]
