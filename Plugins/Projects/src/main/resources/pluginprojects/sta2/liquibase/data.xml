    <changeSet author="scf" id="2024-07-29-ROLES-data-1" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="roles" />
            <tableIsEmpty tableName="roles" />
            <tableExists tableName="user_roles" />
            <not>
                <tableIsEmpty tableName="user_roles" />
            </not>
        </preConditions>

        <sql>insert into "roles" ("role_name","description") select distinct "role_name" rn, "role_name" ds from "user_roles"</sql>
    </changeSet>

    <changeSet author="scf" id="2024-07-29-ROLES-data-2" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="roles" />
            <tableIsEmpty tableName="roles" />
        </preConditions>

        <insert tableName="roles">
            <column name="role_name" value="read" />
            <column name="description" value="Read data" />
        </insert>
        <insert tableName="roles">
            <column name="role_name" value="create" />
            <column name="description" value="Create (POST) Entities" />
        </insert>
        <insert tableName="roles">
            <column name="role_name" value="update" />
            <column name="description" value="Update (PUT/PATCH) Entities" />
        </insert>
        <insert tableName="roles">
            <column name="role_name" value="delete" />
            <column name="description" value="Delete Entities" />
        </insert>
        <insert tableName="roles">
            <column name="role_name" value="admin" />
            <column name="description" value="All actions" />
        </insert>
    </changeSet>

    <changeSet author="scf" id="2025-06-01-ROLES-data-3" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="roles" />
            <sqlCheck expectedResult="0">select count("role_name") from "roles" where "role_name"='obscreate'</sqlCheck>
        </preConditions>

        <insert tableName="roles">
            <column name="role_name" value="obscreate" />
            <column name="description" value="Can create Observations" />
        </insert>
    </changeSet>
    <changeSet author="scf" id="2025-06-01-ROLES-data-4" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="roles" />
            <sqlCheck expectedResult="0">select count("role_name") from "roles" where "role_name"='obsupdate'</sqlCheck>
        </preConditions>

        <insert tableName="roles">
            <column name="role_name" value="obsupdate" />
            <column name="description" value="Can update Observations" />
        </insert>
        <insert tableName="roles">
            <column name="role_name" value="obsdelete" />
            <column name="description" value="Can delete Observations" />
        </insert>

        <insert tableName="roles">
            <column name="role_name" value="obspropcreate" />
            <column name="description" value="Can create ObservedProperties" />
        </insert>
        <insert tableName="roles">
            <column name="role_name" value="obspropupdate" />
            <column name="description" value="Can update ObservedProperties" />
        </insert>
        <insert tableName="roles">
            <column name="role_name" value="obspropdelete" />
            <column name="description" value="Can delete ObservedProperties" />
        </insert>
    </changeSet>



</databaseChangeLog>

