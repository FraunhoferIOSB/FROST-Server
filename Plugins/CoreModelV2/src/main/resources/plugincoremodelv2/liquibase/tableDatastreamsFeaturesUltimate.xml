    <changeSet author="iosb" id="2026-02-06-datastreams_features_ultimate" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="CONTINUE">
            <tableExists tableName="datastreams" />
            <tableExists tableName="features" />
            <not>
                <tableExists tableName="datastreams_features_ultimate" />
            </not>
            <changeLogPropertyDefined property="idType-Datastream" />
            <changeLogPropertyDefined property="idType-Feature" />
        </preConditions>
        <createTable tableName="datastreams_features_ultimate">
            <column name="datastream_id" type="${idType-Datastream}">
                <constraints nullable="false"/>
            </column>
            <column name="feature_id" type="${idType-Feature}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey columnNames="datastream_id, feature_id" constraintName="pk_datastreams_features_ultimate" tableName="datastreams_features_ultimate"/>
        <createIndex tableName="datastreams_features_ultimate" indexName="datastreams_features_ultimate_datastream_id">
            <column name="datastream_id" />
        </createIndex>
        <createIndex tableName="datastreams_features_ultimate" indexName="datastreams_features_ultimate_feature_id">
            <column name="feature_id" />
        </createIndex>
    </changeSet>

</databaseChangeLog>

