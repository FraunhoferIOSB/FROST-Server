    <changeSet author="generated" id="2024-06-05-configurations-1" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="MARK_RAN">
            <changeLogPropertyDefined property="id-Configuration" value="LONG" />
            <not>
                <tableExists tableName="configurations" />
            </not>
        </preConditions>
        <createTable tableName="configurations">
            <column name="id" type="${idTypeLong}" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_configurations" />
            </column>
        </createTable>
    </changeSet>

    <changeSet author="generated" id="2024-06-05-configurations-2" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="MARK_RAN">
            <or>
                <changeLogPropertyDefined property="id-Configuration" value="STRING" />
                <changeLogPropertyDefined property="id-Configuration" value="UUID" />
            </or>
            <not>
                <tableExists tableName="configurations" />
            </not>
        </preConditions>
        <createTable tableName="configurations">
            <column name="id" type="${idType-Configuration}" defaultValueComputed="${defaultValueComputed-Configuration}">
                <constraints primaryKey="true" primaryKeyName="pk_configurations"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="generated" id="2024-06-05-configurations-3" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists columnName="create_time" tableName="configurations" />
            </not>
        </preConditions>
        <addColumn tableName="configurations">
            <column name="thing_id" type="${idType-Thing}"/>
            <column name="create_time" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="applied_time" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="device_status" type="TEXT"/>
            <column name="config_status" type="TEXT"/>
            <column name="config" type="JSONB"/>
        </addColumn>
    </changeSet>

    <changeSet author="generated" id="2024-06-05-configurations-idx-thing_id" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="configurations" indexName="configurations_thing_id" />
            </not>
        </preConditions>
        <createIndex tableName="configurations" indexName="configurations_thing_id">
            <column name="thing_id" />
        </createIndex>
    </changeSet>

</databaseChangeLog>

