    <changeSet author="generated" id="2026-05-03-event_quantity_observations" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="CONTINUE">
            <tableExists tableName="emissionevents" />
            <tableExists tableName="observations" />
            <not>
                <tableExists tableName="event_quantity_observations" />
            </not>
            <changeLogPropertyDefined property="idType-EmissionEvent" />
            <changeLogPropertyDefined property="idType-Observation" />
        </preConditions>
        <createTable tableName="event_quantity_observations">
            <column name="event_id" type="${idType-EmissionEvent}">
                <constraints nullable="false"/>
            </column>
            <column name="observation_id" type="${idType-Observation}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey columnNames="event_id, observation_id" constraintName="pk_event_quantity_observations" tableName="event_quantity_observations"/>
        <createIndex tableName="event_quantity_observations" indexName="event_quantity_observations_event_id">
            <column name="event_id" />
        </createIndex>
        <createIndex tableName="event_quantity_observations" indexName="event_quantity_observations_observation_id">
            <column name="observation_id" />
        </createIndex>
    </changeSet>

