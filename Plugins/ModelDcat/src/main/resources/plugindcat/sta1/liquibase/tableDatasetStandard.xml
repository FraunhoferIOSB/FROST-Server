    <changeSet author="generated" id="2025-06-10-dataset_standard" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="dataset_standard" />
            </not>
        </preConditions>
        <createTable tableName="dataset_standard">
            <column name="service_id" type="${idType-Dataset}">
                <constraints nullable="false"/>
            </column>
            <column name="standard_id" type="${idType-Standard}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey columnNames="service_id, standard_id" constraintName="pk_dataset_standard" tableName="dataset_standard"/>
        <createIndex tableName="dataset_standard" indexName="dataset_standard_service_id">
            <column name="service_id" />
        </createIndex>
        <createIndex tableName="dataset_standard" indexName="dataset_standard_standard_id">
            <column name="standard_id" />
        </createIndex>
    </changeSet>

