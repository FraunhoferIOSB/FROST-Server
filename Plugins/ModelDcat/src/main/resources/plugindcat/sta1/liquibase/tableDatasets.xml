    <changeSet author="generated" id="2025-06-10-dataset-1" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="MARK_RAN">
            <changeLogPropertyDefined property="id-Dataset" value="LONG" />
            <not>
                <tableExists tableName="dataset" />
            </not>
        </preConditions>
        <createTable tableName="dataset">
            <column name="id" type="${idTypeLong}" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_dataset" />
            </column>
        </createTable>
    </changeSet>

    <changeSet author="generated" id="2025-06-10-dataset-2" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="MARK_RAN">
            <or>
                <changeLogPropertyDefined property="id-Dataset" value="STRING" />
                <changeLogPropertyDefined property="id-Dataset" value="UUID" />
            </or>
            <not>
                <tableExists tableName="dataset" />
            </not>
        </preConditions>
        <createTable tableName="dataset">
            <column name="id" type="${idType-Dataset}" defaultValueComputed="${defaultValueComputed-Dataset}">
                <constraints primaryKey="true" primaryKeyName="pk_dataset"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="generated" id="2025-06-10-dataset-3" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists columnName="title" tableName="dataset" />
            </not>
        </preConditions>
        <addColumn tableName="dataset">
            <column name="publisher" type="${idType-Agent}"/>
            <column name="title" type="TEXT"/>
            <column name="description" type="TEXT"/>
            <column name="keywords" type="TEXT"/>
            <column name="temporal_resolution" type="TEXT"/>
            <column name="spatial_resolution" type="DOUBLE"/>
        </addColumn>
    </changeSet>

    <changeSet author="generated" id="2025-06-10-dataset-idx-publisher" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="dataset" indexName="dataset_publisher" />
            </not>
        </preConditions>
        <createIndex tableName="dataset" indexName="dataset_publisher">
            <column name="publisher" />
        </createIndex>
    </changeSet>

</databaseChangeLog>

