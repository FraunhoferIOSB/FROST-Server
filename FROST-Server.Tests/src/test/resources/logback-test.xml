
<configuration>
    <contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
        <!-- reset all previous level configurations of all j.u.l. loggers -->
        <resetJUL>true</resetJUL>
    </contextListener> 

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- pattern>%d{HH:mm:ss.SSS} [%17thread] %-5level %32logger{32} - %msg%n</pattern -->
            <pattern>%d{HH:mm:ss.SSS} %-5level %40logger{40} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="de.fraunhofer.iosb.ilt.frostserver.auth" level="WARN"/>
    <logger name="de.fraunhofer.iosb.ilt.frostserver.FrostMqttServer" level="WARN"/>
    <logger name="de.fraunhofer.iosb.ilt.frostserver.http" level="WARN"/>
    <logger name="de.fraunhofer.iosb.ilt.frostserver.mqtt.moquette.AuthWrapper" level="INFO"/>
    <logger name="de.fraunhofer.iosb.ilt.frostserver.mqtt.SubscriptionManager" level="INFO"/>
    <logger name="de.fraunhofer.iosb.ilt.frostserver.mqtt.SubscriptionSet" level="INFO"/>
    <logger name="de.fraunhofer.iosb.ilt.frostserver.parser" level="OFF"/>
    <logger name="de.fraunhofer.iosb.ilt.frostserver.persistence" level="wARN"/>
    <logger name="de.fraunhofer.iosb.ilt.frostserver.plugin" level="WARN"/>
    <logger name="de.fraunhofer.iosb.ilt.frostserver.service.PluginManager" level="WARN"/>
    <logger name="de.fraunhofer.iosb.ilt.frostserver.service.Service" level="INFO"/>
    <logger name="de.fraunhofer.iosb.ilt.frostserver.settings.Settings" level="WARN"/>
    <logger name="de.fraunhofer.iosb.ilt.frostserver.messagebus" level="WARN"/>
    <logger name="de.fraunhofer.iosb.ilt.frostserver.model" level="WARN"/>
    
    <logger name="de.fraunhofer.iosb.ilt.frostclient.SensorThingsService" level="WARN"/>
    <logger name="de.fraunhofer.iosb.ilt.frostclient.utils.Utils" level="WARN"/>
    <logger name="de.fraunhofer.iosb.ilt.settings" level="WARN"/>

    <logger name="de.fraunhofer.iosb.ilt.statests" level="INFO"/>
    <logger name="de.fraunhofer.iosb.ilt.statests.util.mqtt.MqttListener" level="INFO"/>
    <logger name="de.fraunhofer.iosb.ilt.statests.util.mqtt.MqttHelper2" level="INFO"/>
    
    <logger name="de.fraunhofer.iosb.ilt.statests.f01auth.FineGrainedAuthTests" level="INFO"/>

    <logger name="de.fraunhofer.iosb.ilt.frostclient.query.Query" level="INFO"/>

    <logger name="io.moquette" level="WARN"/>
    <logger name="io.moquette.broker.Authorizator" level="ERROR"/>
    <logger name="io.moquette.broker.PostOffice" level="WARN"/>
    <logger name="io.moquette.broker.metrics.MQTTMessageLogger" level="WARN"/>
    <logger name="io.moquette.broker.NewNettyAcceptor" level="WARN"/>
    <logger name="io.moquette.broker.SessionEventLoop" level="WARN"/>

    <logger name="liquibase" level="WARN"/>
    <logger name="liquibase.analytics.logLevel" level="TRACE"/>

    <logger name="org.eclipse.jetty" level="WARN"/>
    <logger name="org.jooq" level="WARN"/>
    <logger name="org.testcontainers" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
